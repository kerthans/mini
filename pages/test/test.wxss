/* test.wxss */
.container {
  padding: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.button-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-weight: bold;
  margin-bottom: 10rpx;
}

.logs {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.log-item {
  border-bottom: 1rpx solid #eee;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.result {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
  white-space: pre-wrap;
  word-break: break-all;
}