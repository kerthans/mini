/* 整体页面背景 */
.page {
  background-color: #222831;
  position: relative;
  min-height: 100vh;
  padding-bottom: 200rpx; /* 给 bottom image 留出空间，避免被内容遮挡 */
}

/* 容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* 顶部文字 Tab */
.top-tabs {
  display: flex;
  height: 88rpx;
  background: #222831;
}
.tab-item {
  flex: 1;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #aaaaaa;
}
.tab-item.active {
  color: #00ADB5;
  border-bottom: 4rpx solid #00ADB5;
}

/* 排序条（复用你原有样式，稍作精简） */
.sort-bar { 
  width: 100%; 
}
.choser { 
  display: flex; 
  flex-direction: column; 
  align-items: center; }
.sort-select {
  width: 200rpx; 
  height: 60rpx; 
  padding: 12rpx;
  display: flex; 
  justify-content: space-between; 
  align-items: center;
  border-radius: 23rpx;
}
.arrow.folded {
  border-left: 12rpx solid #999;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
}
.arrow.unfolded {
  border-top: 12rpx solid #999;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  transform: translateY(6rpx);
}
.sort-dropdown {
  position: absolute; 
  width: 150rpx; 
  background: #fff;
  border-radius: 0 0 16rpx 16rpx; 
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  margin-top: 60rpx; z-index: 1;
}
.sort-option { 
  padding: 20rpx; 
  color: #666; 
}
.sort-option.active { 
  color: #00ADB5; 
  background: rgba(0,173,181,.1); 
}

/* 列表容器 */
.list-container {
  flex: 1;
  overflow-y: auto;
  padding: 25rpx 25rpx 25rpx 70rpx;  /* 上 右 下 左 */
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 单条 item */
.item-container {
  display: flex;
  align-items: center; 
  width: 619rpx; 
  gap: 30rpx;
  height: 183rpx; 
  background: #fff; 
  color: #393E46; 
  border-radius: 35rpx;
}
.item-image {
  width: 183rpx; 
  height: 183rpx; 
  border-radius: 35rpx 0 0 35rpx;
}
.item-details {
  display: flex; 
  flex-direction: 
  column; justify-content: 
  center; gap: 15rpx;
  width: 200rpx; 
  height: 181rpx;
}
.name {
  font-size: 32rpx; 
  font-weight: 600; 
  color: #393E46;
  overflow: hidden; 
  text-overflow: ellipsis; 
  white-space: nowrap;
}
.start-date { 
  font-size: 21rpx; 
  color: #393E46; 
}
.detail-btn {
  width: 160rpx;  /* 设置你想要的宽度 */
  height: 65rpx;
  background: #00BAAD;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  line-height: 60rpx;
  text-align: center;
  margin: 20rpx;
}

.detail-btn:active { 
  filter: brightness(.95); 
}
.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #111;
}

.time-tag-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.label {
  font-size: 24rpx;
  color: #888;
}

.value {
  font-size: 24rpx;
  color: #333;
}

.tag {
  background-color: #ffeaa7;
  color: #333;
  font-size: 22rpx;
  padding: 4rpx 4rpx;
  border-radius: 24rpx;
  white-space: nowrap;
}

.time-and-tag {
  display: flex;
  flex-direction: row; /* 水平排布（默认值，其实可以省略） */
  align-items: center; /* 垂直方向对齐 */
  gap: 28rpx;           /* 两元素之间的间距 */
  flex-wrap: nowrap;
}
.value {
  display: inline-block;
  white-space: nowrap;    /* 防止内容自动换行 */
  font-size: 24rpx;
  color: #333;
}

.tag {
  display: inline-block;
  white-space: nowrap;    /* 同样防止换行 */
  background-color: #ffeaa7;
  color: #333;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 24rpx;
}
.bottom-image {
  width: 440rpx;
  height: 174rpx;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  z-index: 99;
}
