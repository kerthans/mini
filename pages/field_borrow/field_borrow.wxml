<view class="page">

  <!-- ⬆️ 一级：固定头部容器 -->
  <view class="header-fixed">

    <!-- ① 自定义导航栏 -->
    <navBar class="navbar"
            title="场地申请处理"
            background="#222831"
            color="#fff"
            back="{{true}}"
            home="{{true}}"
            iconTheme="white"
            bindback="handlerGobackClick"
            bindhome="handlerGohomeClick" />

    <!-- ④ 顶部文字 Tab -->
    <view class="top-tabs">
      <view class="tab-item {{currentTab===0?'active':''}}"
            data-index="0"
            bindtap="switchTab">未审核</view>
      <view class="tab-item {{currentTab===1?'active':''}}"
            data-index="1"
            bindtap="switchTab">审核通过</view>
      <view class="tab-item {{currentTab===2?'active':''}}"
            data-index="2"
            bindtap="switchTab">已归还</view>
    </view>
  </view>

  <!-- ⬇️ 主体内容 -->
  <view class="list-container">
    <block wx:for="{{currentList}}" wx:key="event_id">
      <view class="item-container">
        <image src="../../images/object_borrow/2.png" class="item-image" />
        <view class="item-details">
          <!-- 物品名称 -->
          <text class="name">{{item.event_name}}</text>

          <!-- 申请时间 label -->
          <text class="label">申请时间：</text>

          <!-- 时间 + 标签 并排显示 -->
          <view class="time-and-tag">
            <text class="value">{{item.start_time}}</text>
            <view class="tag">{{item.type}}</view>
          </view>
        </view>

        <!-- 详情按钮 -->
        <view class="detail-btn" 
              data-event-id="{{item.event_id}}" 
              bindtap="navigateToDetail">详情</view>
      </view>
    </block>
  </view>
  <image class="bottom-image" src="/images/field_borrow/white_cat.svg" mode="widthFix"></image>
</view>
